---
permalink: /OS/api/dogfs.json
layout: null
sitemap: false
---
{%- comment -%}
The DOG layer's filesystem index. Generated by Jekyll from the real site tree on
every build, so the global filesystem is never a hand-maintained copy of itself:
add a post, and it appears in the OS.
{%- endcomment -%}
{
  "schema": "rapp-os-fs/1.0",
  "layer": "DOG",
  "mode": "ro",
  "origin": {{ site.url | default: "https://kody-w.github.io" | jsonify }},
  "generated_at": "{{ site.time | date_to_xmlschema }}",
  "nodes": [
{%- assign first = true -%}
{%- for p in site.pages -%}
  {%- if p.url and p.url != "" -%}
    {%- unless first %},{% endunless %}{% assign first = false %}
    {"p":{{ p.url | jsonify }},"k":"page","t":{{ p.title | default: p.name | jsonify }}}
  {%- endif -%}
{%- endfor -%}
{%- for f in site.static_files -%}
  {%- unless first %},{% endunless %}{% assign first = false %}
  {"p":{{ f.path | jsonify }},"k":"file","x":{{ f.extname | remove: "." | jsonify }}}
{%- endfor -%}
{%- for e in site.examples -%}
  {%- unless first %},{% endunless %}{% assign first = false %}
  {"p":{{ e.url | jsonify }},"k":"example","t":{{ e.title | jsonify }},"s":{{ e.status | default: "" | jsonify }}}
{%- endfor -%}
{%- for o in site.posts -%}
  {%- unless first %},{% endunless %}{% assign first = false %}
  {"p":{{ o.url | jsonify }},"k":"post","t":{{ o.title | jsonify }},"d":"{{ o.date | date: '%Y-%m-%d' }}"}
{%- endfor -%}
{%- for o in site.twin_posts -%}
  {%- unless first %},{% endunless %}{% assign first = false %}
  {"p":{{ o.url | jsonify }},"k":"twin","t":{{ o.title | jsonify }}}
{%- endfor -%}
  ]
}
